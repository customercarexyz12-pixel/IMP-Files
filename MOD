8. Write a Java Program to implement State Pattern for Gumball Machine. Create instance variable that holds current state from there, we just need to handle all actions, behaviors and state transition that can happen.

interface State {
    void insertCoin();
    void turnCrank();
    void dispense();
}

class GumballMachine {
    State state;

    State noCoin = new NoCoinState(this);
    State hasCoin = new HasCoinState(this);

    GumballMachine() {
        state = noCoin;
    }

    void insertCoin() {
        state.insertCoin();
    }

    void turnCrank() {
        state.turnCrank();
    }

    void dispense() {
        state.dispense();
    }

    void setState(State s) {
        state = s;
    }
}

class NoCoinState implements State {
    GumballMachine machine;

    NoCoinState(GumballMachine m) {
        machine = m;
    }

    public void insertCoin() {
        System.out.println("Coin Inserted");
        machine.setState(machine.hasCoin);
    }

    public void turnCrank() {
        System.out.println("Insert Coin First");
    }

    public void dispense() {
        System.out.println("No Gumball");
    }
}

class HasCoinState implements State {
    GumballMachine machine;

    HasCoinState(GumballMachine m) {
        machine = m;
    }

    public void insertCoin() {
        System.out.println("Coin Already Inserted");
    }

    public void turnCrank() {
        System.out.println("Crank Turned");
        machine.dispense();
    }

    public void dispense() {
        System.out.println("Gumball Dispensed");
        machine.setState(machine.noCoin);
    }
}

public class Main {
    public static void main(String[] args) {

        GumballMachine g = new GumballMachine();

        g.insertCoin();
        g.turnCrank();
    }
}

