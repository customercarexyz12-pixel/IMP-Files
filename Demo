6.	Write a program to get temperature notification using Arduino.
int sensor = A0;
int led = 7;
float temperature;
void setup()
{
  Serial.begin(9600);
  pinMode(led, OUTPUT);
}
void loop()
{
  int value = analogRead(sensor);
  float voltage = value * 5.0 / 1023.0;
  temperature = (voltage - 0.5) * 100;
  Serial.print("Temperature: ");
  Serial.print(temperature);
  Serial.println(" C");
  if (temperature > 30)
  {
    Serial.println("High Temperature Alert!");
    digitalWrite(led, HIGH);
  }
  else
  {
    Serial.println("Temperature Normal");
    digitalWrite(led, LOW);
  }
  delay(1000);
}


7.	Write a program for LDR to vary the light intensity of LED using Arduino
int ldr = A0;
int led = 9;
int value;
int brightness;
void setup()
{
  Serial.begin(9600);
  pinMode(led, OUTPUT);
}
void loop()
{
  value = analogRead(ldr);
  brightness = map(value, 0, 1023, 255, 0);
  analogWrite(led, brightness);
  Serial.print("Light Intensity: ");
  Serial.println(value);
  Serial.print("LED Brightness: ");
  Serial.println(brightness);
  delay(500);
}

